        "tooltip": {
          "hideZeros": false,
          "mode": "single",
          "sort": "none"
        }
      },
      "targets": [
        {
          "editorMode": "code",
          "expr": "sum(rate(quicknotes_http_requests_total{job=\"quicknotes\"}[1m]))",
