[Unit]
Description=Converge QuickNotes from Git with ansible-pull
Wants=network-online.target
After=network-online.target

[Service]
Type=oneshot
WorkingDirectory=/
ExecStart=/usr/bin/ansible-pull -U {{ ansible_pull_repo_url }} -C {{ ansible_pull_branch }} -d {{ ansible_pull_workdir }} -i {{ ansible_pull_inventory_path }} ansible/playbook.yaml -e enable_ansible_pull=true
