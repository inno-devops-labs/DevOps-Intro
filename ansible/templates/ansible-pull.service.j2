[Unit]
Description=Converge QuickNotes configuration from Git
Wants=network-online.target
After=network-online.target

[Service]
Type=oneshot
ExecStart=/usr/bin/ansible-pull -U {{ ansible_pull_repo_url }} -C {{ ansible_pull_branch }} -i {{ ansible_pull_inventory_path }} -l localhost ansible/playbook.yaml
Nice=10
IOSchedulingClass=idle
